import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner s = new Scanner(System.in);
      int a = s.nextInt();
      int b = s.nextInt();
      for(int i=a+1;i<b;i++){
        if(isPrime(i)){
          System.out.println(i);
        }
      }
      s.close();
  }
  public static boolean isPrime(int num){
    if(num<2)
    return false;
    for(int i=2 ;i*i<=num;i++){
      if(num%i==0){
        return false;
      }
    }
    return true;
  }
}
