import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();   
        int original = n;       
        int digits = String.valueOf(n).length();  

        int sum = 0;
        int temp = n;
        while (temp > 0) {
            int digit = temp % 10;  
            sum += Math.pow(digit, digits);  
            temp /= 10;  
        }

        if (sum == original) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }

        sc.close();
    }
}
